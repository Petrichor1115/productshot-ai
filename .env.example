# ---- 服务 ----
PORT=3100
NODE_ENV=development
BASE_URL=http://localhost:3100

# ---- 安全 ----
JWT_SECRET=productshot-ai-dev-secret-change-me
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- 存储 ----
DB_FILE=data/productshot.db
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ---- 管理员初始账号 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- 火山引擎方舟（可选）----
# 配置后自动切换到豆包视觉理解 + Seedream 5.0 Pro 真实出图；
# 留空则降级为本地确定性渲染（仅用于流程演示）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-1-6-vision
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro
ARK_TIMEOUT_MS=30000
