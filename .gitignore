# ---- 依赖 ----
node_modules/
.pnpm-store/

# ---- 环境变量与本地配置（含 API Key，禁止提交）----
.env
.env.local
.env.*.local

# ---- 运行时产物 ----
# SQLite 数据文件（含 WAL / SHM）
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3
# 上传原图与生成结果
uploads/*
!uploads/.gitkeep

# ---- 日志 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ---- 构建与缓存 ----
dist/
build/
coverage/
.nyc_output/
.cache/
.temp/
tmp/

# ---- 文档生成中间文件 ----
.archify/
*.finalize.json
*.browser-check.json
*.delivery.json
*.delivery-pending.json
*.finalize-summary.json

# ---- 编辑器 / 操作系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地备份 ----
backup/
*.bak
*.orig
